# OcultaKey
APP_ENV=production
APP_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
PUBLIC_URL=https://senhas.seudominio.com
PORT=8000

# PostgreSQL do EasyPanel
DATABASE_URL=postgresql+psycopg://ocultakey:SENHA_DO_BANCO@HOST_DO_POSTGRES:5432/ocultakey
DATABASE_SCHEMA=ocultakey

# Somente para o PRIMEIRO boot. Depois de confirmar o primeiro login,
# remova BOOTSTRAP_PASSWORD do EasyPanel. O banco já terá o hash Argon2id
# e as chaves do cofre encapsuladas.
BOOTSTRAP_EMAIL=voce@exemplo.com
BOOTSTRAP_PASSWORD=coloque-aqui-sua-senha-normal-e-forte

ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=30
SECRET_UNLOCK_MINUTES=1
VAULT_AUTO_LOCK_MINUTES=10

# Use apenas a origem real do painel em produção.
CORS_ORIGINS=https://senhas.seudominio.com

MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=7
BACKUP_PATH=/data/backups

# Opcional: Google Drive. Cada instalação open source configura o próprio OAuth.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=root

# Parâmetros do Argon2id usados para derivar a KEK do cofre.
KDF_MEMORY_KIB=65536
KDF_ITERATIONS=3
KDF_PARALLELISM=1
